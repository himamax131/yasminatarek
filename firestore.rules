rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'admin@yasmina-tarek.app';
    }

    match /slots/{slotId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['d', 'h', 'bid'])
                    && request.resource.data.d is string
                    && request.resource.data.h is string
                    && request.resource.data.d.size() == 10
                    && request.resource.data.h.size() == 4
                    && slotId == request.resource.data.d + '_' + request.resource.data.h
                    && (!('bid' in request.resource.data) || request.resource.data.bid is string);
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow create: if request.resource.data.keys().hasOnly([
                        'name', 'phone', 'service', 'd', 'h', 'time',
                        'locationType', 'address', 'notes',
                        'deposit', 'total', 'remaining', 'status',
                        'paymentNumber', 'at',
                        'bookedOn', 'depositPaidOn', 'remainingPaidOn'
                      ])
                    && request.resource.data.name is string && request.resource.data.name.size() <= 80
                    && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
                    && request.resource.data.service is string && request.resource.data.service.size() <= 80
                    && request.resource.data.notes is string && request.resource.data.notes.size() <= 500
                    && request.resource.data.address is string && request.resource.data.address.size() <= 350
                    && request.resource.data.deposit is number && request.resource.data.deposit == 200
                    && request.resource.data.total is number && request.resource.data.total >= 0
                    && request.resource.data.remaining is number
                    && request.resource.data.status is string
                    && request.resource.data.at == request.time
                    && existsAfter(/databases/$(database)/documents/slots/$(request.resource.data.d + '_' + request.resource.data.h))
                    && !exists(/databases/$(database)/documents/closedDays/$(request.resource.data.d));
      allow read: if isAdmin();
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['d', 'h', 'time', 'service', 'name', 'phone',
                                   'deposit', 'remaining', 'status', 'total',
                                   'locationType', 'address', 'notes',
                                   'bookedOn', 'depositPaidOn', 'remainingPaidOn']);
      allow delete: if isAdmin();
    }


    match /closedDays/{dayId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /purchases/{purchaseId} {
      allow read, create, update, delete: if isAdmin();
    }
  }
}
