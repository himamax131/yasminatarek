rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // الأدمن = حساب Firebase Authentication بالإيميل ده (شوفي README)
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'admin@yasmina-tarek.app';
    }

    // slots: الكل بيشوفها علشان يعرفوا الميعاد محجوز ولا لأ (من غير أي بيانات شخصية).
    // bid = رقم الحجز المرتبط بيها (علشان الأدمن يقدر يلغي / يعدّل الحجز).
    match /slots/{slotId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['d', 'h', 'bid'])
                    && request.resource.data.d is string
                    && request.resource.data.h is string
                    && request.resource.data.d.size() == 10
                    && request.resource.data.h.size() == 4
                    && slotId == request.resource.data.d + '_' + request.resource.data.h
                    && (!('bid' in request.resource.data) || request.resource.data.bid is string);
      allow update: if false;
      allow delete: if isAdmin();   // إلغاء / نقل الحجز: للأدمن بس
    }

    // bookings: أي حد يقدر يبعت حجز، بس القراءة والتعديل والحذف للأدمن بس.
    match /bookings/{bookingId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'service', 'd', 'h', 'time', 'locationType', 'address', 'notes', 'deposit', 'paymentNumber', 'at'])
                    && request.resource.data.name is string && request.resource.data.name.size() <= 80
                    && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
                    && request.resource.data.service is string && request.resource.data.service.size() <= 80
                    && request.resource.data.notes is string && request.resource.data.notes.size() <= 300
                    && request.resource.data.address is string && request.resource.data.address.size() <= 350
                    && request.resource.data.at == request.time
                    // لازم الميعاد يتحجز في نفس العملية
                    && existsAfter(/databases/$(database)/documents/slots/$(request.resource.data.d + '_' + request.resource.data.h));
      allow read: if isAdmin();     // عرض حجوزات الشهور
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['d', 'h', 'time', 'service'])
                    && existsAfter(/databases/$(database)/documents/slots/$(request.resource.data.d + '_' + request.resource.data.h));
      allow delete: if isAdmin();
    }
  }
}
