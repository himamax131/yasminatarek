rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // slots: بيشوفها الكل، بس علشان يعرفوا الميعاد محجوز ولا لأ (من غير أي بيانات شخصية).
    // ممكن تتعمل مرة واحدة بس، ومحدش يعدّلها أو يمسحها من الموقع (ده بيمنع الحجز المزدوج).
    match /slots/{slotId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['d', 'h'])
                    && request.resource.data.d is string
                    && request.resource.data.h is string
                    && request.resource.data.d.size() == 10
                    && request.resource.data.h.size() == 4
                    && slotId == request.resource.data.d + '_' + request.resource.data.h;
      allow update, delete: if false;
    }

    // bookings: أي حد يقدر يبعت حجز، بس محدش يقدر يقرأ. إنتي بتشوفيها من Firebase Console.
    match /bookings/{bookingId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'service', 'd', 'h', 'notes', 'deposit', 'at'])
                    && request.resource.data.name is string && request.resource.data.name.size() <= 80
                    && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
                    && request.resource.data.service is string && request.resource.data.service.size() <= 80
                    && request.resource.data.notes is string && request.resource.data.notes.size() <= 300
                    && request.resource.data.at == request.time
                    // لازم الميعاد يتحجز في نفس العملية
                    && existsAfter(/databases/$(database)/documents/slots/$(request.resource.data.d + '_' + request.resource.data.h));
      allow read, update, delete: if false;
    }
  }
}
